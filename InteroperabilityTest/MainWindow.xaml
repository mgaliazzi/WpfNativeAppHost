<Window x:Class="InteroperabilityTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InteroperabilityTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <!-- Fixed Navigation Bar -->
        <StackPanel DockPanel.Dock="Top" Background="LightGray" Orientation="Horizontal">
            <!-- Add your navigation buttons or other controls here -->
            <Button Content="Home"/>
            <Button Content="Settings"/>
            <!-- Add more buttons as needed -->
        </StackPanel>

        <!-- Main Content Area -->
        <DockPanel Name="mainDockPanel">
            <!-- MDI Views -->
            <local:PropertyView x:Name="propertyView" DockPanel.Dock="Left" Width="180"/>
            <local:ReportView x:Name="reportView" DockPanel.Dock="Right" Width="180"/>

            <!-- Add more views as needed -->

            <!-- Central Content Area -->
            <Grid>
                <!-- Content for the central area goes here -->
                <local:ThreeDView x:Name="threeDView" />
            </Grid>
            
        </DockPanel>
    </DockPanel>
</Window>
