{
  // Which application to launch and embed in the WPF shell.
  //
  // The default is Character Map: a plain Win32 application that ships with every copy of
  // Windows, so a fresh clone runs with no setup at all. Swap in whatever you actually want to
  // host - the technique does not care what toolkit the guest is built with.
  //
  // Backslashes must be doubled, because this is JSON:
  //
  //   FreeCAD        "C:\\Program Files\\FreeCAD 1.1\\bin\\freecad.exe"
  //   Qt Designer    "%QTDIR%\\bin\\designer.exe"
  //   Your own app   "..\\..\\..\\build\\output\\YourApp.exe"
  //
  // Relative paths resolve against the shell's own output directory, and environment variables
  // such as %ProgramFiles% are expanded. You can also override all of this without editing the
  // file at all:
  //
  //   dotnet run --project src/WpfNativeAppHost.App -- --host-exe "C:\path\to\your.exe"
  "HostedApp": {
    "ExecutablePath": "%SystemRoot%\\System32\\charmap.exe",
    "Arguments": "",

    // How long to wait for the guest to put a window on screen. A cold FreeCAD start, especially
    // the first one after an install, can take well over ten seconds.
    "StartupTimeoutSeconds": 60
  }
}
